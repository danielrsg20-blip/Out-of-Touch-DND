# Supabase (required in all environments)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Session behavior (default true)
VITE_USE_SUPABASE_SESSIONS=true

# Sprite rendering (default false - uses vector renderer; set to true to use legacy sprite pipeline)
VITE_ENABLE_LEGACY_SPRITES=true
