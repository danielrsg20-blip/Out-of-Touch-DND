# Supabase (required in all environments)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Session behavior (default true)
VITE_USE_SUPABASE_SESSIONS=true

# Optional dev-only local backend values for legacy non-edge endpoints.
# Leave unset in production deployments.
# VITE_API_URL=http://localhost:8010
# VITE_WS_URL=ws://localhost:8010
